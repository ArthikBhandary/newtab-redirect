{
  "manifest_version": 2,
  "name": "New Tab Redirect",
  "version": "1.4.1",
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "optional_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab-redirect@arthik",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
